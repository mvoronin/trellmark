{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmitOnError": true,
    "rootDir": "web/src",
    "outDir": "web/static",
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["web/src/**/*.ts"]
}
