{
  "name": "trellmark-frontend",
  "private": true,
  "type": "commonjs",
  "workspaces": [
    "tools/openapi-types"
  ],
  "scripts": {
    "build": "node scripts/frontend_build.cjs",
    "check:frontend-artifacts": "node scripts/check_frontend_artifacts.cjs",
    "check:imports": "node scripts/check_frontend_imports.cjs",
    "generate:api-types": "npm run generate --workspace trellmark-openapi-types-tool",
    "postinstall": "npm run verify:compiler",
    "typecheck": "tsc --noEmit",
    "verify:compiler": "node scripts/verify_typescript.cjs && tsc --version"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
