                    "type": "boolean"
                  },
                  "parent_id": {
                    "anyOf": [
                      {
                        "minimum": 1.0,
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Parent Id"
                  }
                },
                "required": [
                  "name"
                ],
                "title": "CreateGroup",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
