            "application/json": {
              "schema": {
                "properties": {
                  "domains": {
                    "items": {
                      "type": "string"
                    },
                    "title": "Domains",
                    "type": "array"
                  },
                  "name": {
                    "title": "Name",
                    "type": "string"
                  },
